# Copy to .env (gitignored) and fill in. Never commit real keys.
# Alpaca paper-trading account keys (https://app.alpaca.markets -> Paper -> API keys)
ALPACA_API_KEY_ID=
ALPACA_API_SECRET_KEY=
# Apify API token (https://console.apify.com/settings/integrations), used by the Congress trades source only
APIFY_API_KEY=
# Contact string sent as the User-Agent to SEC EDGAR, which requires one on every request: your name plus a contact
# email, for example "Your Name your.email@example.com". Use your own real contact; the recorder's SEC sources and its
# preflight check need it.
SEC_USER_AGENT=
